# =============================================================================
# ABS IMMO & SERVICES — variables d'environnement (MODÈLE, sans aucun secret)
# Copier vers `.env` (jamais versionné) uniquement si nécessaire.
# =============================================================================

# --- Projet Supabase -----------------------------------------------------------
# Référence du projet (Dashboard > Project Settings > General). Non secret.
SUPABASE_PROJECT_REF=sasssoloprjakfysajvt

# --- Applications React (abs-immo-frontend / abs-immo-backoffice) -------------
# Ces DEUX valeurs sont publiques par conception (protégées par RLS).
# Dashboard > Project Settings > API Keys.
VITE_SUPABASE_URL=https://sasssoloprjakfysajvt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Clé du site Cloudflare Turnstile (publique) si le CAPTCHA est activé.
VITE_TURNSTILE_SITE_KEY=

# --- Secrets des Edge Functions -----------------------------------------------
# NE PAS mettre ces valeurs dans un fichier versionné ni dans React.
# Les définir avec :  npx supabase secrets set NOM=valeur
#
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY sont injectées
# automatiquement par Supabase dans les Edge Functions : ne pas les définir.
#
# Sel de hachage des adresses IP (chaîne aléatoire ≥ 32 caractères) :
#   openssl rand -hex 32
RATE_LIMIT_SALT=
# Origines autorisées pour les formulaires publics (séparées par des virgules).
ALLOWED_ORIGINS=https://abs-immo.sn,https://www.abs-immo.sn
# Origines du back-office (fonction admin-users).
BACKOFFICE_ORIGINS=https://admin.abs-immo.sn
# Secret Cloudflare Turnstile (vide = CAPTCHA désactivé).
TURNSTILE_SECRET_KEY=

# --- CI / déploiement (secrets GitHub Actions, jamais dans le dépôt) ----------
# SUPABASE_ACCESS_TOKEN=   jeton personnel : https://supabase.com/dashboard/account/tokens
# SUPABASE_DB_PASSWORD=    mot de passe de la base (Dashboard > Database)
